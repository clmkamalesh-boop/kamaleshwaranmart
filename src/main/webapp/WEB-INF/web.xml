<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>KamaleshwaranMart</display-name>
    <description>Anna University R2025 Semester 3 Java Capstone Project - Multi-seller E-Commerce Marketplace</description>

    <!-- Database and Application Context Listener -->
    <listener>
        <listener-class>com.kamaleshwaran.kamaleshwaranmart.listener.DatabaseContextListener</listener-class>
    </listener>

    <!-- Global Character Encoding Filter (UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.kamaleshwaran.kamaleshwaranmart.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Filter for Protected Endpoints -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.kamaleshwaran.kamaleshwaranmart.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/orders</url-pattern>
        <url-pattern>/reviews</url-pattern>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/api/v1/cart/*</url-pattern>
        <url-pattern>/api/v1/orders/*</url-pattern>
        <url-pattern>/api/v1/seller/*</url-pattern>
        <url-pattern>/api/v1/admin/*</url-pattern>
    </filter-mapping>

    <!-- Role-Based Access Control Filter -->
    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.kamaleshwaran.kamaleshwaranmart.filter.RoleFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/api/v1/seller/*</url-pattern>
        <url-pattern>/api/v1/admin/*</url-pattern>
    </filter-mapping>

    <!-- Servlet Controllers -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
        <url-pattern>/index</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.ProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductServlet</servlet-name>
        <url-pattern>/products</url-pattern>
        <url-pattern>/product-details</url-pattern>
        <url-pattern>/api/v1/products</url-pattern>
        <url-pattern>/api/v1/products/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/api/v1/cart</url-pattern>
        <url-pattern>/api/v1/cart/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/orders</url-pattern>
        <url-pattern>/api/v1/orders</url-pattern>
        <url-pattern>/api/v1/orders/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/reviews</url-pattern>
        <url-pattern>/api/v1/reviews</url-pattern>
        <url-pattern>/api/v1/reviews/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SellerServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.SellerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellerServlet</servlet-name>
        <url-pattern>/seller</url-pattern>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/api/v1/seller/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/api/v1/admin/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.kamaleshwaran.kamaleshwaranmart.controller.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/api/v1/health</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration: 30 minutes timeout, HttpOnly Cookie -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome Page -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

</web-app>
